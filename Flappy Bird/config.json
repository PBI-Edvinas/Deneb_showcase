{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "background": "transparent",
  "signals": [
    {
      "name": "startTime",
      "init": "now()",
      "on":[
        {
          "events": "signal:continuePressed",
          "update": "continuePressed ? now() : startTime"
        }
      ]
    },
    {
      "name": "gameOver",
      "value": true,
      "update": "gameOver? (continuePressed ? false : true): (boundaryCollision || pipeCollision)",
      "on": [
        {
          "events": "signal:continuePressed", 
          "update": "true", 
          "force": true
        },
        {
          "events": "signal:continuePressed", 
          "update": "now()", 
          "force": true, 
          "assign": "startTime"
        }
      ]
    },
    {
      "name": "elapsed",
      "value": 0,
      "on": [
        {
          "events": {
            "type": "timer",
            "throttle": 16.3
          },
          "update": "continuePressed ? 0 : gameOver ? elapsed : (now() - startTime) / 1000"
        }
      ]
    },
    {
      "name": "globalSpeed",
      "init": "100",
      "on": [
        {
          "events": {
            "signal": "elapsed"
          },
          "update": "gameOver ? globalSpeed : 100 + elapsed / 25"
        }
      ]
    },
    {
      "name": "gravityIntensity",
      "value": 20
    },
    {
      "name": "jumpBoost",
      "value": -2
    },
    {
      "name": "birdSize",
      "value": 32
    },
    {
      "name": "pipeWidth",
      "value": 52
    },
    { 
      "name": "capSize", 
      "value": 20 
    },
    {
      "name": "yposFall",
      "value": 200,
      "on": [
        {
          "events": "timer",
          "update": "elapsed < 0.001 ? 200 : continuePressed ? 200 : clamp(yposFall + (keyPressed ? jumpBoost : gravityIntensity * 0.1), 0, height - birdSize)"
        }
      ]
    },
    {
      "name": "yPrev",
      "value": 20,
      "on": [
        { "events": "timer", "update": "yposFall" }
      ]
    },
    {
      "name": "yVel",
      "value": 20,
      "on": [
        { "events": "timer", "update": "(yposFall - yPrev) * 60" }
      ]
    },
    { "name": "birdAngle", "update": "45" },
    {
      "name": "xposCenter",
      "update": "width/2 - birdSize/2"
    },
    {
      "name": "pipeColor",
      "value": "#1bda9d"
    },
    {
      "name": "keyPressed",
      "value": false,
      "on": [
        {
          "events": "window:keydown",
          "update": "gameOver ? false : (event.keyCode === 32 || event.keyCode === 87 || event.keyCode === 38 ? true : false)"
        },
        {
          "events": "window:keyup",
          "update": "false"
        }
      ]
    },
    {
      "name": "continuePressed",
      "value": false,
      "on": [
        {
          "events": "window:keydown",
          "update": "gameOver && event.keyCode === 13 ? true : false"
        },
        {
          "events": "window:keyup",
          "update": "false"
        }
      ]
    },
    {
      "name": "spawnInterval",
      "update": "2"
    },
    {
      "name": "lastSpawnTime",
      "value": 0,
      "on": [
        {
          "events": {"signal": "elapsed"},
          "update": "shouldSpawn ? elapsed : lastSpawnTime"
        }
      ]
    },
    {
      "name": "shouldSpawn",
      "update": "(elapsed - lastSpawnTime) >= spawnInterval && !gameOver"
    },
    {
      "name": "obstaclesData",
      "update": "data('obstacles')"
    },
    {
        "name": "scoreTrigger",
        "update": "length(data('obstacles')) > 0 && data('obstacles')[0] && (data('obstacles')[0].xpos + pipeWidth < xposCenter) && !data('obstacles')[0].scored"
    },
    {
        "name": "score",
        "value": 0,
        "update": "length(data('obstacles')) > 0 ? data('obstacles')[0].scoreCount : 0"
    },
    {
      "name": "boundaryCollision",
      "update": "yposFall <= 0 || yposFall >= (height - birdSize)"
    },
    {
      "name": "pipeCollision",
      "update": "length(data('collisions')) > 0"
    },
    {
      "name": "collisionDetected",
      "update": "boundaryCollision || pipeCollision",
      "on": [
        {
          "events": 
          {
            "signal": "collisionDetected"
          }, 
          "update": "collisionDetected", 
          "force": true
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "obstacles",
      "values": [],
      "on": [
        {
          "trigger": "shouldSpawn",
          "insert": "({ initialX: width, spawnTime: elapsed, gapHeight: 140 + random() * 80, gapY: 100 + random() * (height - 320), speed: globalSpeed, scored: false })"
        },
        {
          "trigger": "continuePressed",
          "remove": true
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "xpos",
          "expr": "datum.initialX - ((elapsed - datum.spawnTime) / 1) * datum.speed"
        },
        {
          "type": "formula",
          "as": "scored",
          "expr": "datum.scored || (datum.xpos + pipeWidth < xposCenter)"
        },
        {
          "type": "joinaggregate",
          "ops": ["sum"],
          "fields": ["scored"],
          "as": ["scoreCount"]
        },
        {
          "type": "filter",
          "expr": "datum.xpos > - pipeWidth"
        }
      ]
    },
    {
      "name": "collisions",
      "source": "obstacles",
      "transform": [
        {
          "type": "formula",
          "as": "collided",
          "expr": "(datum.xpos < xposCenter + birdSize && datum.xpos + pipeWidth > xposCenter) & (yposFall < datum.gapY || yposFall + birdSize > datum.gapY + datum.gapHeight)"
        },
        {
          "type": "filter",
          "expr": "datum.collided"
        }
      ]
    },
    {
      "name": "pipesUp",
      "source": "obstacles",
      "transform": [
        {
          "type": "formula",
          "as": "pipeType",
          "expr": "'up'"
        },
        {
          "type": "formula",
          "as": "pipeHeight",
          "expr": "datum.gapY"
        }
      ]
    },
    {
      "name": "pipesDown", 
      "source": "obstacles",
      "transform": [
        {
          "type": "formula",
          "as": "pipeType",
          "expr": "'down'"
        },
        {
          "type": "formula",
          "as": "pipeHeight",
          "expr": "height - (datum.gapY + datum.gapHeight)"
        },
        {
          "type": "formula",
          "as": "pipeY",
          "expr": "datum.gapY + datum.gapHeight"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "image",
      "from": { "data": "dataset" },
      "encode": {
        "enter": {
          "url": {"field": "Bird"},
          "width": {"signal": "birdSize"},
          "height": {"signal": "birdSize"},
          "origin": { "signal": "xposCenter + ',' + (yposFall + birdSize/2)" }
        },
        "update": {
          "x": {"signal": "xposCenter"},
          "y": {"signal": "yposFall"},
          "opacity": {"signal": "gameOver ? 0.5 : 1"},
          "angle":   { "signal": "birdAngle" }
        }
      }
    },
    {
        "type": "group",
        "from": {"data": "obstacles"},
        "encode": {
          "update": {
            "x": {"field": "xpos"},
            "y": {"value": 0},
            "width": {"signal": "pipeWidth + 20"},
            "height": {"field": "gapY"}
          }
        },
        "marks": [
          {
            "type": "path",
            "encode": {
              "enter": {
                "path": {
                  "signal": "'M10,0 L' + (pipeWidth + 10) + ',0 L' + (pipeWidth + 10) + ',' + (parent.gapY - 30) + ' L10,' + (parent.gapY - 30) + ' Z'"
                },
                "fill": {"value": "#228B22"},
                "stroke": {"value": "#006400"},
                "strokeWidth": {"value": 2}
              }
            }
          },
          {
            "type": "path",
            "encode": {
              "enter": {
                "path": {
                  "signal": "'M0,' + (parent.gapY - 30) + ' L' + (pipeWidth + 20) + ',' + (parent.gapY - 30) + ' L' + (pipeWidth + 20) + ',' + parent.gapY + ' L0,' + parent.gapY + ' Z'"
                },
                "fill": {"value": "#32CD32"},
                "stroke": {"value": "#006400"},
                "strokeWidth": {"value": 2}
              }
            }
          }
        ]
      },
      {
        "type": "group",
        "from": {"data": "obstacles"},
        "encode": {
          "update": {
            "x": {"field": "xpos"},
            "y": {"signal": "datum.gapY + datum.gapHeight"},
            "width": {"signal": "pipeWidth + 20"},
            "height": {"signal": "height - (datum.gapY + datum.gapHeight)"}
          }
        },
        "marks": [
          {
            "type": "path",
            "encode": {
              "enter": {
                "path": {
                  "signal": "'M0,0 L' + (pipeWidth + 20) + ',0 L' + (pipeWidth + 20) + ',30 L0,30 Z'"
                },
                "fill": {"value": "#32CD32"},
                "stroke": {"value": "#006400"},
                "strokeWidth": {"value": 2}
              }
            }
          },
          {
            "type": "path",
            "encode": {
              "enter": {
                "path": {
                  "signal": "'M10,30 L' + (pipeWidth + 10) + ',30 L' + (pipeWidth + 10) + ',' + (height - parent.gapY - parent.gapHeight) + ' L10,' + (height - parent.gapY - parent.gapHeight) + ' Z'"
                },
                "fill": {"value": "#228B22"},
                "stroke": {"value": "#006400"},
                "strokeWidth": {"value": 2}
              }
            }
          }
        ]
      },
    {
      "type": "text",
      "description": "Score",
      "encode": {
        "enter": {
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 24 },
          "fontWeight": { "value": "bold" },
          "fill": { "value": "#444444" }
        },
        "update": {
          "x": { "signal": "width/2" },
          "y": { "signal": "25" },
          "text": { "signal": "'Score : ' + score" },
          "opacity": { "signal": "0.7" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 24 },
          "fontWeight": { "value": "bold" },
          "fill": { "value": "red" }
        },
        "update": {
          "x": { "signal": "width/2" },
          "y": { "signal": "height/2 - 50" },
          "text": { "signal": "gameOver ? (elapsed < 0.001 ? 'FLAPPY START' : 'GAME OVER') : ''" },
          "opacity": { "signal": "0.7" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 16 },
          "fill": { "value": "black" }
        },
        "update": {
          "x": { "signal": "width/2" },
          "y": { "signal": "height/2 - 20" },
          "text": { 
            "signal": "gameOver ? (elapsed < 0.001 ? 'Press Enter to start the game' : 'Press Enter to restart the game') : 'Press Space, W, or Up Arrow to jump'" 
          },
          "opacity": { 
            "signal": "gameOver ? (elapsed < 0.001 ? 0.7 : 0.7) : min(1 - elapsed/10)"
          }
        }
      }
    }
  ]
}
